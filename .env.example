# Copy to .env (gitignored) and adjust.

# Base URL of a llama.cpp server or router. Leave unset to show the server as down.
KEYLIGHTS_LLAMA_URL=http://localhost:8080

# Color the managed keys return to, as hex.
KEYLIGHTS_BASE_COLOR=ffffff

# Maximum blinks per second for the DEL (inference) and ESC (network) keys.
KEYLIGHTS_DEL_BLINK_CAP=20
KEYLIGHTS_ESC_BLINK_CAP=10

# Seconds between reads of the inference server and network counters, and of temperature and mic state.
KEYLIGHTS_POLL_INTERVAL=0.5
KEYLIGHTS_SLOW_POLL_INTERVAL=2

# AlienFX zone of the power button on this model, and render rate in Hz.
KEYLIGHTS_POWER_ZONE=1
KEYLIGHTS_TICK_HZ=50
