# Copy to .env (gitignored) and adjust. Every setting is listed in the README.

# Inference keys: KEY=kind:url[#selector], comma separated. Kinds: llama, ollama, gpu.
KEYLIGHTS_LIGHTS=DEL=llama:http://localhost:8080

# Colour the managed keys return to on exit, as hex.
KEYLIGHTS_BASE_COLOR=ffffff

# Render rate, and the maximum blinks per second for inference keys and ESC.
KEYLIGHTS_TICK_HZ=50
KEYLIGHTS_DEL_BLINK_CAP=20
KEYLIGHTS_ESC_BLINK_CAP=10

# Seconds between reads of servers and network counters, and of temperature and mute state.
KEYLIGHTS_POLL_INTERVAL=0.5
KEYLIGHTS_SLOW_POLL_INTERVAL=2

# AlienFX zone of the power button on this model.
KEYLIGHTS_POWER_ZONE=1
